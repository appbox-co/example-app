#!/usr/bin/env node
// appbox-kuma-admin — ask Uptime Kuma about, or create, its admin account
//
// Usage: appbox-kuma-admin need-setup | setup
//   need-setup  prints "true" while Uptime Kuma has no user, "false" once it
//               has one
//   setup       creates the admin from USERNAME and PASSWORD in the
//               environment and prints "ok", or "rejected" when Uptime Kuma
//               refused the account (a weak password, or a user already
//               exists)
// Exits 1 when Uptime Kuma does not answer within 30 s.
//
// Credentials come from the environment and never reach a command line.
// Uptime Kuma's error message is not printed: only the result word is.
'use strict';

const { io } = require(require.resolve('socket.io-client', { paths: ['/app'] }));

const mode = process.argv[2];
const url = process.env.APPBOX_KUMA_URL || 'http://localhost:3001';
const socket = io(url, { reconnection: false, timeout: 30000 });

function finish(output, code) {
    clearTimeout(timer);
    if (output) {
        console.log(output);
    }
    socket.close();
    process.exit(code);
}

const timer = setTimeout(() => finish(null, 1), 30000);

socket.on('connect_error', () => finish(null, 1));
socket.on('connect', () => {
    if (mode === 'need-setup') {
        socket.emit('needSetup', (need) => {
            if (typeof need === 'boolean') {
                finish(need ? 'true' : 'false', 0);
            } else {
                finish(null, 1);
            }
        });
    } else if (mode === 'setup') {
        socket.emit('setup', process.env.USERNAME, process.env.PASSWORD, (res) => {
            finish(res && res.ok ? 'ok' : 'rejected', 0);
        });
    } else {
        finish(null, 1);
    }
});
